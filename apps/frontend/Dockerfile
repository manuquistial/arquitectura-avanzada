# Multi-stage build for production optimization
FROM node:22-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./
RUN npm ci --only=production --no-audit --no-fund && npm cache clean --force

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

# Build-time environment variables for Next.js
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_AUTH_SERVICE_URL=""
ARG NEXT_PUBLIC_CITIZEN_SERVICE_URL=""
ARG NEXT_PUBLIC_INGESTION_SERVICE_URL=""
ARG NEXT_PUBLIC_SIGNATURE_SERVICE_URL=""
ARG NEXT_PUBLIC_TRANSFER_SERVICE_URL=""
ARG NEXT_PUBLIC_MINTIC_SERVICE_URL=""
ARG NEXT_PUBLIC_METADATA_SERVICE_URL=""
ARG NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=""
ARG NEXT_PUBLIC_USE_PROXY=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_AUTH_SERVICE_URL=${NEXT_PUBLIC_AUTH_SERVICE_URL}
ENV NEXT_PUBLIC_CITIZEN_SERVICE_URL=${NEXT_PUBLIC_CITIZEN_SERVICE_URL}
ENV NEXT_PUBLIC_INGESTION_SERVICE_URL=${NEXT_PUBLIC_INGESTION_SERVICE_URL}
ENV NEXT_PUBLIC_SIGNATURE_SERVICE_URL=${NEXT_PUBLIC_SIGNATURE_SERVICE_URL}
ENV NEXT_PUBLIC_TRANSFER_SERVICE_URL=${NEXT_PUBLIC_TRANSFER_SERVICE_URL}
ENV NEXT_PUBLIC_MINTIC_SERVICE_URL=${NEXT_PUBLIC_MINTIC_SERVICE_URL}
ENV NEXT_PUBLIC_METADATA_SERVICE_URL=${NEXT_PUBLIC_METADATA_SERVICE_URL}
ENV NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=${NEXT_PUBLIC_NOTIFICATION_SERVICE_URL}
ENV NEXT_PUBLIC_USE_PROXY=${NEXT_PUBLIC_USE_PROXY}

# Copy source code
COPY . .

# Disable telemetry and set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build the application
RUN npm run build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_AUTH_SERVICE_URL=""
ARG NEXT_PUBLIC_CITIZEN_SERVICE_URL=""
ARG NEXT_PUBLIC_INGESTION_SERVICE_URL=""
ARG NEXT_PUBLIC_SIGNATURE_SERVICE_URL=""
ARG NEXT_PUBLIC_TRANSFER_SERVICE_URL=""
ARG NEXT_PUBLIC_MINTIC_SERVICE_URL=""
ARG NEXT_PUBLIC_METADATA_SERVICE_URL=""
ARG NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=""
ARG NEXT_PUBLIC_USE_PROXY=""

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_AUTH_SERVICE_URL=${NEXT_PUBLIC_AUTH_SERVICE_URL}
ENV NEXT_PUBLIC_CITIZEN_SERVICE_URL=${NEXT_PUBLIC_CITIZEN_SERVICE_URL}
ENV NEXT_PUBLIC_INGESTION_SERVICE_URL=${NEXT_PUBLIC_INGESTION_SERVICE_URL}
ENV NEXT_PUBLIC_SIGNATURE_SERVICE_URL=${NEXT_PUBLIC_SIGNATURE_SERVICE_URL}
ENV NEXT_PUBLIC_TRANSFER_SERVICE_URL=${NEXT_PUBLIC_TRANSFER_SERVICE_URL}
ENV NEXT_PUBLIC_MINTIC_SERVICE_URL=${NEXT_PUBLIC_MINTIC_SERVICE_URL}
ENV NEXT_PUBLIC_METADATA_SERVICE_URL=${NEXT_PUBLIC_METADATA_SERVICE_URL}
ENV NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=${NEXT_PUBLIC_NOTIFICATION_SERVICE_URL}
ENV NEXT_PUBLIC_USE_PROXY=${NEXT_PUBLIC_USE_PROXY}

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

# Expose port
EXPOSE 3000

# Set environment variables
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Start the application
CMD ["node", "server.js"]