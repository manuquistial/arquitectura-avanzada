# Carpeta Ciudadana Layer Configuration

# Environment
environment = "production"
namespace   = "carpeta-ciudadana"

# M2M Secret Key
m2m_secret_key = "your-m2m-secret-key"

# Domain configuration
domain_name = "carpeta-ciudadana.example.com"
enable_tls  = true

# Frontend configuration
# Dejar vacío para auto-detección de la URL del LoadBalancer
frontend_url = ""
# nextauth_secret is automatically generated by Terraform and stored in Azure Key Vault

# Front Door configuration - DESHABILITADO
# El proyecto usa LoadBalancer de Kubernetes + Ingress para routing
# Front Door está deshabilitado por defecto. Si necesitas habilitarlo más adelante,
# cambia esta variable a true y configura los hostnames.
frontdoor_enabled           = false  # Deshabilitado - usando LoadBalancer de Kubernetes
frontdoor_frontend_hostname = ""     # Solo necesario si frontdoor_enabled = true
frontdoor_api_hostname       = ""     # Solo necesario si frontdoor_enabled = true
frontdoor_enable_waf         = false  # Solo necesario si frontdoor_enabled = true

# Azure subscription
azure_subscription_id = "f5b9ada6-2216-4ffb-8833-1f52700a2569"
